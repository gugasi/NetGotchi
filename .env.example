# netgotchi environment variable template
# Copy to .env and fill in values. Never commit .env to version control.
#
# Docker secrets or GitHub Actions encrypted secrets should be used
# for any production or CI deployment.

# --- Backend -------------------------------------------------
SNIFFER_BIN=./sniffer
SNIFFER_RESTART_DELAY_S=3.0

# Lock this down in prod. Wildcards are convenient but permit any origin.
# Example prod value: https://netgotchi.yourdomain.com
ALLOWED_ORIGIN=http://localhost:5173

# --- Frontend (Vite) -----------------------------------------
# Vite only exposes vars prefixed with VITE_ to the browser bundle.
VITE_API_HOST=localhost:8000

# --- Future integrations (leave blank for MVP) ---------------
# FIREWALL_API_KEY=
# PFSENSE_HOST=
# SPLUNK_HEC_TOKEN=
# DATADOG_API_KEY=
